# Fill in real values and save as `backup.env` next to docker-compose.yml
# (Docker path), or as /etc/hikyaku-backup/backup.env, chmod 600, owned by
# the hikyaku-backup user (bare-metal path -- see README.md). Plain
# key=value, no quoting or `export` needed: this file is `source`d directly
# by backup.sh, can be pointed to by systemd's EnvironmentFile=, and is
# loaded as-is by Docker Compose's env_file:.

# ---- Postgres ----
# A connection string pg_dump can use as-is. Either the session pooler (port
# 5432 via *.pooler.supabase.com -- same host this repo's own DB_URL uses)
# or the direct connection (DB_MIGRATION_URL) work. Avoid the 6543
# transaction pooler: pg_dump holds one long-lived snapshot for the whole
# dump, which transaction-mode pooling can scramble.
# Add ?sslmode=require to at least encrypt in transit, or
# ?sslmode=verify-full&sslrootcert=<path> (see DB_SSL_CA_PATH in the app's
# own .env.example) to also verify Supabase's certificate.
DB_BACKUP_URL=postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require

# ---- Supabase Storage (S3-compatible), read directly by rclone ----
# These are real rclone remote-config vars (RCLONE_CONFIG_<REMOTE>_<KEY>,
# remote name "supastorage") rather than names backup.sh translates, so a
# plain `docker compose exec backup rclone ...` also has a working
# `supastorage:` remote during a restore (see RESTORE.md) -- nothing extra
# to re-export.
#
# TYPE/PROVIDER/ENV_AUTH are fixed for how Supabase exposes Storage over
# S3 -- normally leave them as-is. Fill in the other four from the Supabase
# dashboard: Project Settings -> Storage -> S3 Connection. Generate a
# dedicated access key pair for this -- it is NOT the same as
# SUPABASE_SERVICE_ROLE_KEY.
RCLONE_CONFIG_SUPASTORAGE_TYPE=s3
RCLONE_CONFIG_SUPASTORAGE_PROVIDER=Other
RCLONE_CONFIG_SUPASTORAGE_ENV_AUTH=false
RCLONE_CONFIG_SUPASTORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
RCLONE_CONFIG_SUPASTORAGE_REGION=us-east-1
RCLONE_CONFIG_SUPASTORAGE_ACCESS_KEY_ID=
RCLONE_CONFIG_SUPASTORAGE_SECRET_ACCESS_KEY=
# Optional. Comma-separated bucket ids to back up, e.g. avatars,org-logos.
# Leave unset to auto-discover every bucket the access key above can see.
STORAGE_BUCKETS=

# ---- restic repository (where the encrypted, deduplicated backups live) ----
# Local path, per current setup -- see README.md for how to add an offsite
# copy later without changing anything above this line.
RESTIC_REPOSITORY=/var/backups/hikyaku/restic-repo
# Path to a file holding the repository password -- NOT the password
# itself. Generate it once with:
#   openssl rand -base64 48 > /etc/hikyaku-backup/restic-password
#   chmod 600 /etc/hikyaku-backup/restic-password
# Copy the password to a password manager too. It is the only key to every
# backup restic ever writes -- restic's encryption has no back door, so
# losing both copies makes the entire repository permanently unreadable.
RESTIC_PASSWORD_FILE=/etc/hikyaku-backup/restic-password

# ---- Retention ----
# Snapshots tagged "full" (the 1st of each month, plus the very first run
# against an empty repo) are kept for this many months, then pruned.
RETENTION_FULL_MONTHS=6
# Snapshots tagged "incremental" (every other day) are kept for this many
# days. 35 comfortably spans a month plus buffer so there's always overlap
# with the last full snapshot; raise it for a longer day-by-day recovery
# window -- restic's dedup makes that cheap.
RETENTION_INCREMENTAL_DAYS=35

# ---- Local scratch space ----
# Holds the plaintext pg_dump file and synced storage files for the
# duration of one run only -- wiped before restic ingests them and again
# afterwards. Needs free space for one copy of the DB dump + all storage
# buckets.
BACKUP_STAGING_DIR=/var/backups/hikyaku/staging
BACKUP_LOCK_FILE=/var/backups/hikyaku/backup.lock

# Set to 1 to force a "full" tagged run regardless of the date (e.g. before
# a risky migration). Leave at 0 for normal scheduled runs.
FORCE_FULL=0

# ---- Scheduling (Docker path only -- ignored by the systemd timer, which
# gets its schedule from hikyaku-backup.timer's OnCalendar= instead) ----
# 24-hour HH:MM, checked against the container's own clock/timezone.
BACKUP_TIME=03:15
# IANA name, e.g. Australia/Sydney. Requires tzdata, already in the image.
# Leave unset (or UTC) to schedule in UTC.
TZ=UTC
# Where entrypoint.sh records the date of the last successful run, so a
# container restart knows whether today's backup already happened.
LAST_RUN_MARKER=/var/backups/hikyaku/last-run-date
