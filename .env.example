
DB_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/postgres
# Connection used by the TypeORM migration CLI (migration:run runs on every
# `pnpm start:prod`). Point this at Supabase's DIRECT connection (port 5432),
# NOT the 6543 transaction pooler — DDL and advisory locks are unreliable under
# transaction pooling. Falls back to DB_URL when unset.
DB_MIGRATION_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/postgres
# Optional. Path to a CA certificate (e.g. Supabase's, from Project Settings >
# Database > SSL Configuration) used to verify Postgres's TLS certificate.
# Both DB connections (TypeORM's pool and the LISTEN/NOTIFY client) upgrade to
# SSL when this is set AND the file exists at that path; otherwise they fall
# back to plain, unencrypted TCP — e.g. a local Postgres with no cert issued.
DB_SSL_CA_PATH=
VALHALLA_URL=http://localhost:8002
VROOM_URL=http://localhost:3000
PHOTON_URL=http://localhost:2322
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxx

CORS_DOMAIN=http://localhost:3000,https://hikyaku.org

STRIPE_API_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx
# Signing secret for the general /api/v1/stripe/webhook endpoint (checkout.session.*
# and, as of BillingService, customer.subscription.*). The restricted STRIPE_API_KEY
# needs Customers/Subscriptions/Prices write access for subscription provisioning to
# work — Checkout Sessions + PaymentIntents alone is not enough.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx
# Stripe Issuing webhook signing secret (from `stripe listen` or the Dashboard
# endpoint subscribed to issuing.* events). Required by the issuing webhook.
STRIPE_ISSUING_WEBHOOK_SECRET=whsec_xxxxxx


MAILER_SENDER_EMAIL=auth@hikyaku.org
MAILER_HOST=localhost
MAILER_USER=xxxx
MAILER_PASSWORD=xxxxxx


APP_URL=http://localhost:3000

# Optional. Tier 1 instant assignment. Anything but `nightly` means instant;
# `nightly` is the emergency stop that leaves new packages PENDING for a
# dispatcher to place by hand.
ASSIGNMENT_MODE=instant
# Optional, defaults to on. Spreads packages across the vans that are already
# out instead of packing the first one full (see LOAD_SPREAD_SECONDS_PER_STOP in
# src/dispatch/insertion.ts). Set it to `false` or `0` to restore the old
# bin-packer without a deploy: reach for that if an org's shift billing or its
# total driving distance moves the wrong way, since looser routes burn the 12h
# window faster and can push packages onto a newly opened, billed shift.
LOAD_SPREAD_ENABLED=true

# Optional. Error tracking (Sentry) is only enabled when this is set.
SENTRY_DSN=